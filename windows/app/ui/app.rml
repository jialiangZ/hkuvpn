<rml>
<head>
    <title>HKU VPN</title>
    <link type="text/rcss" href="app.rcss"/>
</head>
<body>
  <div id="app">

    <div id="header">
      <img id="badge" src="assets/badge.tga"/>
      <div id="titles">
        <div id="app-title">HKU VPN</div>
        <div id="app-sub">HKU Portal VPN &#183; vpn2fa.hku.hk</div>
      </div>
    </div>

    <div id="status-card">
      <span id="status-dot"></span>
      <span id="status-text">Disconnected</span>
      <span id="status-duration">--:--:--</span>
      <div id="primary-value">Not connected</div>
      <div class="detail-row" id="row-proxy">
        <div class="detail-label">Proxy</div>
        <div class="detail-value">socks5://127.0.0.1:1080 &#183; http://127.0.0.1:1088</div>
      </div>
      <div class="detail-row" id="row-routes">
        <div class="detail-label">Routes</div>
        <div class="detail-value" id="info-routes">-</div>
      </div>
    </div>

    <div id="account-card">
      <div id="account-title">Account</div>
      <div class="field-label" id="lbl-account">HKU account</div>
      <input id="account" type="text" placeholder="u1234567@connect.hku.hk"/>
      <div class="field-label" id="lbl-pin">Portal PIN</div>
      <input id="pin" type="password" placeholder="Portal password"/>
    </div>

    <div id="btn-connect" class="primary">Connect</div>

    <div id="btn-log" class="ghost">
      <img src="assets/log.tga"/>
      <span>View log</span>
    </div>
    <div id="btn-save-account" class="ghost">Save</div>
    <div id="footer-hint">Closing this window keeps the VPN running in the tray.</div>
  </div>

  <!-- Log -->
  <div id="log-overlay" class="overlay">
    <div id="log-dialog" class="dialog">
      <div class="dlg-title">Connection log</div>
      <div id="log-view"><div id="log-content"></div></div>
      <div class="dlg-buttons">
        <div id="btn-log-clear" class="btn">Clear</div>
        <div id="btn-log-close" class="btn primary">Close</div>
      </div>
    </div>
  </div>

  <!-- MFA -->
  <div id="mfa-overlay" class="overlay">
    <div id="mfa-dialog" class="dialog">
      <div class="dlg-title">Verification code</div>
      <div class="dlg-sub">Enter the 6-digit code from Microsoft Authenticator.</div>
      <div id="mfa-note"></div>
      <input id="mfa-code" type="text" maxlength="6" placeholder="000000"/>
      <div id="btn-mfa" class="btn primary">Submit</div>
      <div id="mfa-hint">Enter to submit &#183; Esc to cancel</div>
    </div>
  </div>
</body>
</rml>
