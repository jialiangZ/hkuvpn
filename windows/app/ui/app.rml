<rml>
<head>
    <title>HKU VPN</title>
    <link type="text/rcss" href="app.rcss"/>
</head>
<body>
    <div id="main-bg">
        <div id="menu-bar">
            <input type="button" class="menu" id="menu-file" value="File"/>
            <input type="button" class="menu" id="menu-view" value="View"/>
            <input type="button" class="menu" id="menu-settings" value="Settings"/>
            <input type="button" class="menu" id="menu-help" value="Help"/>
        </div>

        <div id="tabs">
            <div class="tab active" id="tab-main">Main</div>
            <div class="tab" id="tab-vpninfo">VPN Info</div>
        </div>

        <div id="page-main">
            <div id="panel">
                <img id="lock-icon" src="assets/lock-red.tga"/>
                <div id="content">
                    <div id="server-row">
                        <label id="server-label">Server:</label>
                        <div id="server-box"><span id="server-value">vpn2fa.hku.hk</span></div>
                        <div id="btn-settings" class="icon-btn" title="HKU account settings"><img src="assets/settings.tga"/></div>
                    </div>
                    <div id="status-row">Disconnected</div>
                    <div id="button-row">
                        <div id="btn-connect" class="btn primary">Connect</div>
                        <div id="btn-log" class="btn">View log</div>
                    </div>
                </div>
            </div>
        </div>

        <div id="page-vpninfo">
            <div class="info-grid">
                <div class="info-row"><div class="info-label">IPv4:</div><div class="info-value" id="info-ip4">-</div></div>
                <div class="info-row"><div class="info-label">IPv6:</div><div class="info-value" id="info-ip6">-</div></div>
                <div class="info-row"><div class="info-label">DNS:</div><div class="info-value" id="info-dns">-</div></div>
                <div class="info-row"><div class="info-label">Cipher:</div><div class="info-value" id="info-cipher">-</div></div>
                <div class="info-row"><div class="info-label">Status:</div><div class="info-value" id="info-status">-</div></div>
                <div class="info-row"><div class="info-label">Duration:</div><div class="info-value" id="info-duration">-</div></div>
                <div class="info-row"><div class="info-label">Routes:</div><div class="info-value" id="info-routes">-</div></div>
                <div class="info-row"><div class="info-label">Heartbeat:</div><div class="info-value" id="info-hb">-</div></div>
            </div>
        </div>
    </div>

    <!-- Settings dialog -->
    <div id="settings-overlay">
        <div id="settings-dialog">
            <div class="dlg-title">HKU Account Settings</div>
            <div class="field">
                <label>HKU account</label>
                <input id="account" type="text" placeholder="u1234567@connect.hku.hk"/>
            </div>
            <div class="field">
                <label>Portal PIN</label>
                <input id="pin" type="password" placeholder="Portal password"/>
            </div>
            <div class="field">
                <label>Server</label>
                <input id="server-edit" type="text" value="vpn2fa.hku.hk"/>
            </div>
            <div class="dlg-buttons">
                <div id="btn-settings-save" class="btn primary">Save</div>
                <div id="btn-settings-close" class="btn">Close</div>
            </div>
        </div>
    </div>

    <!-- Log dialog -->
    <div id="log-overlay">
        <div id="log-dialog">
            <div class="dlg-title">OpenConnect Log</div>
            <div id="log-view"><div id="log-content"></div></div>
            <div class="dlg-buttons">
                <div id="btn-log-clear" class="btn">Clear</div>
                <div id="btn-log-close" class="btn">Close</div>
            </div>
        </div>
    </div>

    <!-- MFA dialog -->
    <div id="mfa-overlay">
        <div id="mfa-dialog">
            <div class="dlg-title">Microsoft Authenticator</div>
            <div class="mfa-text">Enter the 6-digit code from your authenticator app:</div>
            <div id="mfa-note"></div>
            <div class="mfa-row">
                <input id="mfa-code" type="text" maxlength="6"/>
                <div id="btn-mfa" class="btn primary">Submit</div>
            </div>
            <div class="mfa-hint">Enter to submit &#183; Esc to cancel the connection</div>
        </div>
    </div>

    <!-- About dialog -->
    <div id="about-overlay">
        <div id="about-dialog">
            <div class="dlg-title">About HKU VPN</div>
            <div class="about-text">HKU campus VPN frontend for the HKU Portal 2FA gateway.<br/>Server: vpn2fa.hku.hk</div>
            <div class="dlg-buttons">
                <div id="btn-about-close" class="btn">Close</div>
            </div>
        </div>
    </div>
</body>
</rml>
