/* Classic OpenConnect-style UI for HKU VPN, rebuilt in RmlUi. */

body {
    font-family: "Segoe UI";
    font-size: 13dp;
    color: #1f1f1f;
    background: #f0f0f0;
}

#main-bg {
    width: 434dp;
    height: 206dp;
    background: #f0f0f0;
}

/* menu */
#menu-bar {
    position: absolute;
    left: 0dp;
    top: 0dp;
    width: 434dp;
    height: 22dp;
    background: #f0f0f0;
}
.menu {
    float: left;
    height: 22dp;
    padding: 2dp 8dp;
    background: #f0f0f0;
    color: #000;
    border: 0dp;
    font-size: 13dp;
    text-align: left;
}
.menu:hover {
    background: #e5f1fb;
    border: 1dp #99d1ff;
}

/* tabs */
#tabs {
    position: absolute;
    left: 10dp;
    top: 24dp;
    width: 414dp;
    height: 24dp;
}
.tab {
    display: inline-block;
    padding: 4dp 12dp;
    background: #d9d9d9;
    border-top-left-radius: 3dp;
    border-top-right-radius: 3dp;
    border: 1dp #a0a0a0;
    border-bottom: 0dp;
    margin-right: 4dp;
    color: #000;
    font-size: 13dp;
}
.tab.active {
    background: #ffffff;
}

/* main page */
#page-main {
    position: absolute;
    left: 10dp;
    top: 48dp;
    width: 414dp;
    height: 150dp;
}
#panel {
    position: relative;
    width: 414dp;
    height: 150dp;
    background: #ffffff;
    border: 1dp #a0a0a0;
    border-top: 0dp;
}
#lock-icon {
    position: absolute;
    left: 14dp;
    top: 27dp;
    width: 72dp;
    height: 72dp;
}
#content {
    position: absolute;
    left: 96dp;
    top: 24dp;
    width: 304dp;
    height: 104dp;
}
#button-row {
    position: absolute;
    left: 98dp;
    top: 89dp;
    width: 302dp;
    height: 28dp;
}
#status-row {
    position: absolute;
    left: 98dp;
    top: 55dp;
    width: 302dp;
    height: 20dp;
    font-size: 13dp;
    color: #555;
}
#server-row {
    height: 23dp;
}
#server-label {
    display: inline-block;
    width: 44dp;
    height: 22dp;
    vertical-align: middle;
}
#server-box {
    display: inline-block;
    width: 216dp;
    height: 22dp;
    background: #ffffff;
    border: 1dp #7a7a7a;
    vertical-align: middle;
}
#server-value {
    margin-left: 4dp;
    margin-top: 2dp;
    font-size: 13dp;
    color: #000;
}
.icon-btn {
    display: inline-block;
    width: 22dp;
    height: 22dp;
    margin-left: 4dp;
    background: #e1e1e1;
    border: 1dp #adadad;
    vertical-align: middle;
}
.icon-btn img {
    margin-top: 2dp;
    margin-left: 2dp;
    width: 16dp;
    height: 16dp;
}

.btn {
    display: inline-block;
    width: 112dp;
    height: 24dp;
    padding: 2dp 6dp;
    background: #e1e1e1;
    border: 1dp #adadad;
    color: #000;
    font-size: 13dp;
    text-align: center;
    vertical-align: middle;
}
.btn.primary {
    background: #e1e1e1;
    border: 1dp #0078d7;
    color: #000;
}
.btn:hover {
    background: #e5f1fb;
    border: 1dp #0078d7;
}
.btn:active {
    background: #cce4f7;
    border: 1dp #005499;
}
.btn.disabled {
    background: #f0f0f0;
    border: 1dp #bfbfbf;
    color: #838383;
}
#btn-log {
    margin-left: 8dp;
    width: 112dp;
}

/* vpn info */
#page-vpninfo {
    display: none;
    position: absolute;
    left: 10dp;
    top: 48dp;
    width: 414dp;
    height: 150dp;
    background: #ffffff;
    border: 1dp #a0a0a0;
    border-top: 0dp;
}
.info-grid {
    margin: 10dp;
    width: 394dp;
}
.info-row {
    height: 20dp;
    margin-bottom: 2dp;
}
.info-label {
    display: inline-block;
    width: 70dp;
    font-weight: bold;
    font-size: 13dp;
}
.info-value {
    display: inline-block;
    width: 318dp;
    font-size: 13dp;
    color: #000;
}

/* overlays */
#settings-overlay, #log-overlay, #mfa-overlay, #about-overlay {
    display: none;
    position: absolute;
    left: 0dp;
    top: 0dp;
    width: 434dp;
    height: 206dp;
    background: #00000044;
    z-index: 20;
}
#settings-overlay.visible, #log-overlay.visible, #mfa-overlay.visible, #about-overlay.visible {
    display: block;
}

/* dialogs */
#settings-dialog {
    position: absolute;
    left: 67dp;
    top: 30dp;
    width: 300dp;
    height: 146dp;
    background: #ffffff;
    border: 1dp #9a9a9a;
    padding: 10dp;
    box-sizing: border-box;
}
.dlg-title {
    font-size: 13dp;
    font-weight: bold;
    margin-bottom: 8dp;
}
.field {
    margin-bottom: 6dp;
}
.field label {
    display: block;
    font-size: 12dp;
    color: #555;
    margin-bottom: 2dp;
}
.field input {
    display: block;
    box-sizing: border-box;
    width: 278dp;
    height: 24dp;
    padding: 1dp 4dp;
    background: #ffffff;
    border: 1dp #7a7a7a;
    font-size: 13dp;
    color: #000;
}
.dlg-buttons {
    margin-top: 8dp;
    text-align: right;
}
.dlg-buttons .btn {
    min-width: 72dp;
    height: 23dp;
    margin-left: 6dp;
    padding: 1dp 8dp;
}

#log-dialog {
    position: absolute;
    left: 17dp;
    top: 25dp;
    width: 400dp;
    height: 160dp;
    background: #ffffff;
    border: 1dp #9a9a9a;
    padding: 8dp;
    box-sizing: border-box;
}
#log-view {
    position: absolute;
    left: 8dp;
    top: 30dp;
    width: 384dp;
    height: 94dp;
    background: #ffffff;
    border: 1dp #7a7a7a;
    overflow-y: auto;
    overflow-x: auto;
}
#log-content {
    padding: 2dp 4dp;
    font-family: Consolas;
    font-size: 11dp;
    color: #000;
    white-space: nowrap;
}
#log-content div {
    height: 14dp;
}
#log-dialog .dlg-buttons {
    position: absolute;
    right: 8dp;
    bottom: 6dp;
}

#mfa-dialog {
    position: absolute;
    left: 77dp;
    top: 42dp;
    width: 280dp;
    height: 120dp;
    background: #ffffff;
    border: 1dp #9a9a9a;
    padding: 10dp;
    box-sizing: border-box;
}
.mfa-text {
    font-size: 12dp;
    margin-bottom: 4dp;
}
#mfa-note {
    font-size: 11dp;
    color: #c42b2b;
    height: 14dp;
}
.mfa-row {
    margin-top: 4dp;
}
#mfa-code {
    display: inline-block;
    box-sizing: border-box;
    width: 160dp;
    height: 24dp;
    padding: 1dp 6dp;
    border: 1dp #7a7a7a;
    font-family: Consolas;
    font-size: 14dp;
    text-align: center;
}
#btn-mfa {
    display: inline-block;
    margin-left: 6dp;
    min-width: 72dp;
    height: 24dp;
}
.mfa-hint {
    margin-top: 8dp;
    font-size: 10dp;
    color: #777;
}

#about-dialog {
    position: absolute;
    left: 92dp;
    top: 58dp;
    width: 250dp;
    height: 90dp;
    background: #ffffff;
    border: 1dp #9a9a9a;
    padding: 10dp;
    box-sizing: border-box;
}
.about-text {
    font-size: 12dp;
    color: #333;
    margin-bottom: 8dp;
}
