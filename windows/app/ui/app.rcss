/* HKU VPN - compact, modern light UI.
   Sizes are dp, so RmlUi scales them with the monitor DPI. */

body {
    margin: 0dp;
    padding: 0dp;
    font-family: "Segoe UI";
    font-size: 13dp;
    color: #0f172a;
    background: #f4f5f7;
}

#app {
    width: 420dp;
    height: 380dp;
    background: #f4f5f7;
}

/* ---------------------------------------------------------------- header */

#header {
    position: absolute;
    left: 24dp;
    top: 22dp;
    width: 372dp;
    height: 44dp;
}

#badge {
    position: absolute;
    left: 0dp;
    top: 2dp;
    width: 40dp;
    height: 40dp;
}

#titles {
    position: absolute;
    left: 52dp;
    top: 1dp;
    width: 260dp;
}

#app-title {
    display: block;
    font-size: 16dp;
    font-weight: bold;
    color: #0f172a;
}

#app-sub {
    display: block;
    margin-top: 3dp;
    font-size: 11dp;
    color: #6b7280;
}

.icon-btn {
    position: absolute;
    left: 342dp;
    top: 2dp;
    width: 30dp;
    height: 30dp;
    background: #ffffff;
    border: 1dp #e2e5ea;
    border-radius: 8dp;
}

.icon-btn:hover {
    background: #eef2f7;
    border: 1dp #c9d2dc;
}

.icon-btn img {
    position: absolute;
    left: 7dp;
    top: 7dp;
    width: 16dp;
    height: 16dp;
}

/* ------------------------------------------------------------ status card */

#status-card {
    position: absolute;
    left: 24dp;
    top: 84dp;
    width: 372dp;
    height: 140dp;
    background: #ffffff;
    border: 1dp #e6e8ec;
    border-radius: 12dp;
}

#status-dot {
    position: absolute;
    left: 18dp;
    top: 21dp;
    width: 9dp;
    height: 9dp;
    border-radius: 5dp;
    background: #9aa1a9;
}

#status-text {
    position: absolute;
    left: 34dp;
    top: 14dp;
    width: 200dp;
    height: 22dp;
    font-size: 13dp;
    font-weight: bold;
    color: #111827;
}

#status-duration {
    position: absolute;
    left: 240dp;
    top: 16dp;
    width: 114dp;
    text-align: right;
    font-family: Consolas;
    font-size: 12dp;
    color: #8a9199;
}

#primary-value {
    position: absolute;
    left: 18dp;
    top: 40dp;
    width: 336dp;
    height: 30dp;
    font-size: 20dp;
    font-weight: bold;
    color: #0f172a;
}

#primary-value.idle {
    font-size: 15dp;
    font-weight: normal;
    color: #8a9199;
}

.detail-row {
    position: absolute;
    left: 18dp;
    width: 336dp;
    height: 16dp;
}

#row-proxy {
    top: 82dp;
}

.detail-label {
    display: inline-block;
    width: 58dp;
    font-size: 11dp;
    color: #9aa1a9;
}

.detail-value {
    display: inline-block;
    width: 270dp;
    font-size: 11dp;
    color: #4b5563;
}

#row-routes {
    top: 102dp;
}

/* --------------------------------------------------------------- actions */

#btn-connect {
    position: absolute;
    left: 24dp;
    top: 240dp;
    width: 372dp;
    height: 44dp;
    box-sizing: border-box;
    border-radius: 9dp;
    font-size: 14dp;
    font-weight: bold;
    text-align: center;
    line-height: 42dp;
    color: #ffffff;
    background: #0b6b45;
    border: 1dp #0b6b45;
}

#btn-connect:hover {
    background: #0a5c3c;
    border: 1dp #0a5c3c;
}

#btn-connect:active {
    background: #084b31;
    border: 1dp #084b31;
}

#btn-connect.danger {
    color: #b42318;
    background: #ffffff;
    border: 1dp #f0b4ae;
}

#btn-connect.danger:hover {
    background: #fef4f3;
    border: 1dp #e08b83;
}

#btn-connect.warning {
    color: #ffffff;
    background: #b45309;
    border: 1dp #b45309;
}

#btn-connect.disabled {
    color: #ffffff;
    background: #9aa1a9;
    border: 1dp #9aa1a9;
}

#btn-log {
    position: absolute;
    left: 24dp;
    top: 298dp;
    width: 118dp;
    height: 32dp;
    box-sizing: border-box;
    background: #ffffff;
    border: 1dp #e2e5ea;
    border-radius: 8dp;
}

#btn-log:hover {
    background: #eef2f7;
    border: 1dp #c9d2dc;
}

#btn-log img {
    position: absolute;
    left: 11dp;
    top: 8dp;
    width: 15dp;
    height: 15dp;
}

#btn-log span {
    position: absolute;
    left: 34dp;
    top: 7dp;
    font-size: 12dp;
    color: #374151;
}

#footer-hint {
    position: absolute;
    left: 24dp;
    top: 342dp;
    width: 372dp;
    font-size: 10dp;
    color: #9aa1a9;
}

/* --------------------------------------------------------------- dialogs */

.overlay {
    display: none;
    position: absolute;
    left: 0dp;
    top: 0dp;
    width: 420dp;
    height: 380dp;
    background: #0f172a33;
    z-index: 100;
}

.overlay.visible {
    display: block;
}

.dialog {
    position: absolute;
    background: #ffffff;
    border: 1dp #e2e5ea;
    border-radius: 12dp;
    padding: 20dp;
    box-sizing: border-box;
}

.dlg-title {
    display: block;
    font-size: 15dp;
    font-weight: bold;
    color: #0f172a;
}

.dlg-sub {
    display: block;
    margin-top: 4dp;
    font-size: 11dp;
    color: #6b7280;
}

.dlg-buttons {
    position: absolute;
    right: 20dp;
    bottom: 16dp;
    height: 30dp;
}

.btn {
    display: inline-block;
    box-sizing: border-box;
    width: 84dp;
    height: 30dp;
    margin-left: 8dp;
    line-height: 28dp;
    text-align: center;
    font-size: 12dp;
    color: #374151;
    background: #ffffff;
    border: 1dp #d8dce2;
    border-radius: 7dp;
}

.btn:hover {
    background: #f2f5f8;
    border: 1dp #c2cad3;
}

.btn:active {
    background: #e8edf2;
}

.btn.primary {
    color: #ffffff;
    background: #0b6b45;
    border: 1dp #0b6b45;
}

.btn.primary:hover {
    background: #0a5c3c;
    border: 1dp #0a5c3c;
}

.btn.disabled {
    color: #9aa1a9;
    background: #f4f5f7;
    border: 1dp #e2e5ea;
}

/* settings */
#settings-dialog {
    left: 40dp;
    top: 66dp;
    width: 340dp;
    height: 232dp;
}

.field {
    display: block;
    margin-top: 12dp;
}

.field-label {
    display: block;
    margin-bottom: 4dp;
    font-size: 11dp;
    color: #6b7280;
}

.field input {
    display: block;
    box-sizing: border-box;
    width: 300dp;
    height: 32dp;
    padding: 0dp 9dp;
    font-size: 13dp;
    color: #0f172a;
    background: #ffffff;
    border: 1dp #d8dce2;
    border-radius: 7dp;
}

.field input:focus {
    border: 1dp #0b6b45;
}

/* log */
#log-dialog {
    left: 20dp;
    top: 40dp;
    width: 380dp;
    height: 300dp;
    padding: 18dp;
}

#log-view {
    position: absolute;
    left: 18dp;
    top: 62dp;
    width: 344dp;
    height: 176dp;
    background: #fafbfc;
    border: 1dp #e6e8ec;
    border-radius: 8dp;
    overflow-y: auto;
    overflow-x: hidden;
}

#log-content {
    padding: 8dp 10dp;
    font-family: Consolas;
    font-size: 11dp;
    color: #374151;
    white-space: normal;
}

#log-content div {
    display: block;
    width: 322dp;
    margin-bottom: 2dp;
}

#log-dialog .dlg-buttons {
    bottom: 16dp;
}

/* mfa */
#mfa-dialog {
    left: 40dp;
    top: 92dp;
    width: 340dp;
    height: 190dp;
}

#mfa-note {
    position: absolute;
    left: 20dp;
    top: 64dp;
    width: 300dp;
    height: 26dp;
    font-size: 11dp;
    color: #b42318;
}

#mfa-code {
    position: absolute;
    left: 20dp;
    top: 96dp;
    box-sizing: border-box;
    width: 184dp;
    height: 34dp;
    padding: 0dp 10dp;
    font-family: Consolas;
    font-size: 17dp;
    text-align: center;
    color: #0f172a;
    background: #ffffff;
    border: 1dp #d8dce2;
    border-radius: 7dp;
}

#mfa-code:focus {
    border: 1dp #0b6b45;
}

#btn-mfa {
    position: absolute;
    left: 212dp;
    top: 96dp;
    width: 108dp;
    height: 34dp;
    line-height: 32dp;
    margin-left: 0dp;
}

#mfa-hint {
    position: absolute;
    left: 20dp;
    top: 146dp;
    font-size: 10dp;
    color: #9aa1a9;
}

