/* HKU VPN - classic desktop layout with a clean, flat finish.
   Sizes are in dp: RmlUi scales them with the monitor DPI. */

body {
    margin: 0dp;
    padding: 0dp;
    font-family: "Segoe UI";
    font-size: 13dp;
    color: #1b1f23;
    background: #f3f4f6;
}

#app {
    z-index: 0;
    width: 470dp;
    height: 232dp;
    background: #f3f4f6;
}

/* ------------------------------------------------------------- menu bar */

#menubar {
    position: absolute;
    left: 4dp;
    top: 0dp;
    width: 470dp;
    height: 24dp;
    background: #f3f4f6;
}

.menu {
    display: inline-block;
    height: 24dp;
    padding: 0dp 10dp;
    line-height: 24dp;
    font-size: 12dp;
    color: #202428;
    background: #f3f4f6;
}

.menu:hover {
    background: #e2ecf7;
}

/* ---------------------------------------------------------------- tabs */

#tabs {
    position: absolute;
    left: 10dp;
    top: 25dp;
    width: 450dp;
    height: 26dp;
}

.tab {
    display: inline-block;
    height: 25dp;
    padding: 0dp 16dp;
    margin-right: 3dp;
    line-height: 25dp;
    font-size: 12dp;
    color: #4a5158;
    background: transparent;
    border: 1dp transparent;
    border-bottom: 0dp;
    border-top-left-radius: 4dp;
    border-top-right-radius: 4dp;
}

.tab:hover {
    background: #e7eaee;
}

.tab.active {
    height: 26dp;
    background: #ffffff;
    color: #111518;
    font-weight: bold;
}

/* --------------------------------------------------------------- pages */

.page {
    display: none;
    position: absolute;
    left: 10dp;
    top: 50dp;
    width: 450dp;
    height: 148dp;
    background: #ffffff;
    border: 1dp #b6babf;
}

.page.active {
    display: block;
}

/* ------------------------------------------------------------ main page */

#lock-wrap {
    position: absolute;
    left: 18dp;
    top: 40dp;
    width: 72dp;
    height: 72dp;
}

#main-right {
    position: absolute;
    left: 106dp;
    top: 30dp;
    width: 330dp;
}

#server-row {
    height: 24dp;
}

#server-label {
    display: inline-block;
    width: 50dp;
    height: 24dp;
    line-height: 24dp;
    font-size: 13dp;
    color: #202428;
}

#server-combo {
    display: inline-block;
    width: 202dp;
    height: 24dp;
    background: #ffffff;
    border: 1dp #8c9096;
    border-radius: 2dp;
}

#server-value {
    display: inline-block;
    margin-left: 7dp;
    margin-top: 2dp;
    width: 165dp;
    font-size: 13dp;
    color: #1b1f23;
}

#combo-arrow {
    display: inline-block;
    width: 12dp;
    height: 24dp;
    margin-left: 4dp;
}

#combo-arrow img {
    margin-top: 7dp;
    width: 12dp;
    height: 12dp;
}

.icon-btn {
    display: inline-block;
    width: 26dp;
    height: 24dp;
    margin-left: 6dp;
    background: #f6f7f8;
    border: 1dp #b6babf;
    border-radius: 2dp;
}

.icon-btn:hover {
    background: #eaf2fa;
    border: 1dp #8fb8dd;
}

.icon-btn img {
    margin-left: 5dp;
    margin-top: 4dp;
    width: 16dp;
    height: 16dp;
}

#actions {
    margin-top: 28dp;
    height: 30dp;
}

/* -------------------------------------------------------------- buttons */

.btn {
    display: inline-block;
    box-sizing: border-box;
    width: 142dp;
    height: 27dp;
    padding: 0dp 10dp;
    line-height: 25dp;
    font-size: 13dp;
    text-align: center;
    color: #1b1f23;
    background: #f7f8f9;
    border: 1dp #b6babf;
    border-radius: 3dp;
}

.btn:hover {
    background: #eef5fb;
    border: 1dp #8fb8dd;
}

.btn:active {
    background: #dfeaf5;
    border: 1dp #6d9cc4;
}

.btn.primary {
    color: #ffffff;
    background: #0f6b46;
    border: 1dp #0f6b46;
}

.btn.primary:hover {
    background: #138054;
    border: 1dp #138054;
}

.btn.primary:active {
    background: #0b5638;
    border: 1dp #0b5638;
}

.btn.danger {
    color: #b42318;
    background: #ffffff;
    border: 1dp #d92d20;
}

.btn.danger:hover {
    background: #fef3f2;
}

.btn.disabled {
    color: #9aa0a6;
    background: #f2f3f4;
    border: 1dp #d5d8db;
}

#btn-log {
    width: 128dp;
    margin-left: 8dp;
}

#btn-log img {
    display: inline-block;
    width: 14dp;
    height: 14dp;
    margin-right: 6dp;
    margin-top: 6dp;
}

#btn-log span {
    display: inline-block;
    height: 25dp;
    line-height: 25dp;
}

/* ------------------------------------------------------------ vpn info */

#page-vpninfo {
    padding: 12dp 18dp;
    box-sizing: border-box;
}

.info-row {
    height: 17dp;
    margin-bottom: 3dp;
}

.info-label {
    display: inline-block;
    width: 118dp;
    font-size: 12dp;
    color: #6a7178;
}

.info-value {
    display: inline-block;
    width: 290dp;
    font-size: 13dp;
    color: #1b1f23;
}

/* ----------------------------------------------------------- status bar */

#statusbar {
    position: absolute;
    left: 0dp;
    top: 204dp;
    width: 470dp;
    height: 24dp;
    box-sizing: border-box;
    background: #eceef1;
    border-top: 1dp #d5d8db;
}

#status-dot {
    display: inline-block;
    width: 8dp;
    height: 8dp;
    margin-left: 12dp;
    margin-top: 8dp;
    margin-right: 8dp;
    border-radius: 4dp;
    background: #8b9096;
}

#status-text {
    display: inline-block;
    height: 23dp;
    line-height: 23dp;
    font-size: 11dp;
    color: #3d444c;
}

#status-meta {
    display: inline-block;
    height: 23dp;
    line-height: 23dp;
    margin-left: 12dp;
    font-size: 11dp;
    color: #6a7178;
}

/* -------------------------------------------------------------- dialogs */

.overlay {
    display: none;
    position: absolute;
    left: 0dp;
    top: 0dp;
    width: 470dp;
    height: 232dp;
    background: #1b1f2340;
    z-index: 200;
}

.overlay.visible {
    display: block;
}

.dialog {
    position: absolute;
    background: #ffffff;
    border: 1dp #9aa0a6;
    border-radius: 5dp;
    padding: 16dp;
    box-sizing: border-box;
}

.dlg-title {
    display: block;
    font-size: 15dp;
    font-weight: bold;
    color: #111518;
}

.dlg-sub {
    display: block;
    margin-top: 3dp;
    font-size: 11dp;
    color: #6a7178;
}

.dlg-buttons {
    position: absolute;
    right: 16dp;
    bottom: 14dp;
}

.dlg-buttons .btn {
    width: 78dp;
    height: 25dp;
    line-height: 23dp;
    margin-left: 8dp;
    font-size: 12dp;
}

/* settings */
#settings-dialog {
    left: 75dp;
    top: 13dp;
    width: 320dp;
    height: 206dp;
}

.field {
    display: block;
    margin-top: 10dp;
}

.field-label {
    display: block;
    font-size: 11dp;
    color: #4a5158;
    margin-bottom: 3dp;
}

.field input {
    display: block;
    box-sizing: border-box;
    width: 288dp;
    height: 24dp;
    padding: 0dp 7dp;
    font-size: 13dp;
    color: #1b1f23;
    background: #ffffff;
    border: 1dp #8c9096;
    border-radius: 2dp;
}

.field input:focus {
    border: 1dp #0f6b46;
}

/* log */
#log-dialog {
    left: 20dp;
    top: 7dp;
    width: 430dp;
    height: 218dp;
    padding: 14dp;
}

#log-view {
    position: absolute;
    left: 14dp;
    top: 48dp;
    width: 402dp;
    height: 128dp;
    background: #fbfcfd;
    border: 1dp #d5d8db;
    border-radius: 2dp;
    overflow-y: auto;
    overflow-x: hidden;
}

#log-content {
    padding: 5dp 7dp;
    font-family: Consolas;
    font-size: 11dp;
    color: #24292f;
    white-space: normal;
}

#log-content div {
    display: block;
    width: 384dp;
    margin-bottom: 1dp;
}

#log-dialog .dlg-buttons {
    bottom: 12dp;
}

/* mfa */
#mfa-dialog {
    left: 75dp;
    top: 32dp;
    width: 320dp;
    height: 168dp;
}

#mfa-note {
    display: block;
    margin-top: 8dp;
    height: 14dp;
    font-size: 11dp;
    color: #b42318;
}

#mfa-row {
    margin-top: 4dp;
    height: 28dp;
}

#mfa-code {
    display: inline-block;
    box-sizing: border-box;
    width: 180dp;
    height: 27dp;
    padding: 0dp 10dp;
    font-family: Consolas;
    font-size: 16dp;
    text-align: center;
    color: #1b1f23;
    background: #ffffff;
    border: 1dp #8c9096;
    border-radius: 2dp;
}

#mfa-code:focus {
    border: 1dp #0f6b46;
}

#btn-mfa {
    width: 100dp;
    margin-left: 8dp;
}

#mfa-hint {
    display: block;
    margin-top: 10dp;
    font-size: 10dp;
    color: #8b9096;
}

/* about */
#about-dialog {
    left: 105dp;
    top: 28dp;
    width: 260dp;
    height: 176dp;
}

.about-line {
    display: block;
    margin-top: 6dp;
    font-size: 12dp;
    color: #3d444c;
}

/* ------------------------------------------------------------ file menu */

#file-menu {
    display: none;
    position: absolute;
    left: 8dp;
    top: 25dp;
    width: 132dp;
    background: #ffffff;
    border: 1dp #b6babf;
    z-index: 40;
}

#file-menu.visible {
    display: block;
}

.file-item {
    display: block;
    height: 26dp;
    padding: 0dp 12dp;
    line-height: 26dp;
    font-size: 12dp;
    color: #202428;
    background: #ffffff;
}

.file-item:hover {
    background: #e8f1fa;
}
