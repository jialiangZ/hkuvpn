/* HKU VPN - compact, modern light UI (larger type).
   Sizes are dp, so RmlUi scales them with the monitor DPI. */

body {
    margin: 0dp;
    padding: 0dp;
    font-family: "Segoe UI";
    font-size: 15dp;
    color: #0f172a;
    background: #f4f5f7;
}

#app {
    width: 480dp;
    height: 620dp;
    background: #f4f5f7;
}

/* ---------------------------------------------------------------- header */

#header {
    position: absolute;
    left: 28dp;
    top: 26dp;
    width: 424dp;
    height: 52dp;
}

#titles {
    position: absolute;
    left: 0dp;
    top: 2dp;
    width: 424dp;
}

#app-title {
    display: block;
    font-size: 20dp;
    font-weight: bold;
    color: #0f172a;
}

#app-sub {
    display: block;
    margin-top: 4dp;
    font-size: 13dp;
    color: #6b7280;
}

/* ------------------------------------------------------------ status card */

#status-card {
    position: absolute;
    left: 28dp;
    top: 92dp;
    width: 424dp;
    height: 152dp;
    background: #ffffff;
    border: 1dp #e6e8ec;
    border-radius: 14dp;
}

#status-dot {
    position: absolute;
    left: 20dp;
    top: 23dp;
    width: 11dp;
    height: 11dp;
    border-radius: 6dp;
    background: #9aa1a9;
}

#status-text {
    position: absolute;
    left: 38dp;
    top: 15dp;
    width: 220dp;
    height: 26dp;
    font-size: 15dp;
    font-weight: bold;
    color: #111827;
}

#status-duration {
    position: absolute;
    left: 268dp;
    top: 17dp;
    width: 136dp;
    text-align: right;
    font-family: Consolas;
    font-size: 14dp;
    color: #8a9199;
}

#primary-value {
    position: absolute;
    left: 20dp;
    top: 46dp;
    width: 384dp;
    height: 38dp;
    font-size: 26dp;
    font-weight: bold;
    color: #0f172a;
}

#primary-value.idle {
    font-size: 19dp;
    font-weight: normal;
    color: #8a9199;
}

.detail-row {
    position: absolute;
    left: 20dp;
    width: 384dp;
    height: 20dp;
}

#row-proxy {
    top: 98dp;
}

#row-routes {
    top: 122dp;
}

.detail-label {
    display: inline-block;
    width: 72dp;
    font-size: 13dp;
    color: #8a9199;
}

.detail-value {
    display: inline-block;
    width: 308dp;
    font-size: 13dp;
    color: #4b5563;
}

/* --------------------------------------------------------- account card */

#account-card {
    position: absolute;
    left: 28dp;
    top: 260dp;
    width: 424dp;
    height: 192dp;
    background: #ffffff;
    border: 1dp #e6e8ec;
    border-radius: 14dp;
}

#account-title {
    position: absolute;
    left: 20dp;
    top: 16dp;
    font-size: 15dp;
    font-weight: bold;
    color: #374151;
}

.field-label {
    position: absolute;
    left: 20dp;
    font-size: 13dp;
    color: #6b7280;
}

#lbl-account {
    top: 48dp;
}

#lbl-pin {
    top: 118dp;
}

#account, #pin {
    position: absolute;
    left: 20dp;
    box-sizing: border-box;
    width: 384dp;
    height: 38dp;
    padding: 0dp 11dp;
    font-size: 15dp;
    color: #0f172a;
    background: #ffffff;
    border: 1dp #d8dce2;
    border-radius: 8dp;
}

#account {
    top: 68dp;
}

#pin {
    top: 138dp;
}

#account:focus, #pin:focus {
    border: 1dp #0b6b45;
}

/* --------------------------------------------------------------- actions */

#btn-connect {
    position: absolute;
    left: 28dp;
    top: 470dp;
    width: 424dp;
    height: 52dp;
    box-sizing: border-box;
    border-radius: 10dp;
    font-size: 17dp;
    font-weight: bold;
    text-align: center;
    line-height: 50dp;
    color: #ffffff;
    background: #0b6b45;
    border: 1dp #0b6b45;
}

#btn-connect:hover {
    background: #0a5c3c;
    border: 1dp #0a5c3c;
}

#btn-connect:active {
    background: #084b31;
    border: 1dp #084b31;
}

#btn-connect.danger {
    color: #b42318;
    background: #ffffff;
    border: 1dp #f0b4ae;
}

#btn-connect.danger:hover {
    background: #fef4f3;
    border: 1dp #e08b83;
}

#btn-connect.warning {
    color: #ffffff;
    background: #b45309;
    border: 1dp #b45309;
}

#btn-connect.disabled {
    color: #ffffff;
    background: #9aa1a9;
    border: 1dp #9aa1a9;
}

#btn-log {
    position: absolute;
    left: 28dp;
    top: 538dp;
    width: 148dp;
    height: 40dp;
    box-sizing: border-box;
    background: #ffffff;
    border: 1dp #e2e5ea;
    border-radius: 9dp;
}

#btn-log:hover {
    background: #eef2f7;
    border: 1dp #c9d2dc;
}

#btn-log img {
    position: absolute;
    left: 13dp;
    top: 11dp;
    width: 18dp;
    height: 18dp;
}

#btn-log span {
    position: absolute;
    left: 40dp;
    top: 8dp;
    font-size: 14dp;
    color: #374151;
}

#footer-hint {
    position: absolute;
    left: 28dp;
    top: 590dp;
    width: 424dp;
    font-size: 12dp;
    color: #9aa1a9;
}

/* --------------------------------------------------------------- dialogs */

.overlay {
    display: none;
    position: absolute;
    left: 0dp;
    top: 0dp;
    width: 480dp;
    height: 620dp;
    background: #0f172a33;
    z-index: 100;
}

.overlay.visible {
    display: block;
}

.dialog {
    position: absolute;
    background: #ffffff;
    border: 1dp #e2e5ea;
    border-radius: 14dp;
    padding: 24dp;
    box-sizing: border-box;
}

.dlg-title {
    display: block;
    font-size: 19dp;
    font-weight: bold;
    color: #0f172a;
}

.dlg-sub {
    display: block;
    margin-top: 5dp;
    font-size: 13dp;
    color: #6b7280;
}

.btn {
    display: inline-block;
    box-sizing: border-box;
    width: 100dp;
    height: 38dp;
    margin-left: 10dp;
    line-height: 36dp;
    text-align: center;
    font-size: 14dp;
    color: #374151;
    background: #ffffff;
    border: 1dp #d8dce2;
    border-radius: 8dp;
}

.btn:hover {
    background: #f2f5f8;
    border: 1dp #c2cad3;
}

.btn:active {
    background: #e8edf2;
}

.btn.primary {
    color: #ffffff;
    background: #0b6b45;
    border: 1dp #0b6b45;
}

.btn.primary:hover {
    background: #0a5c3c;
    border: 1dp #0a5c3c;
}

/* log */
#log-dialog {
    left: 20dp;
    top: 46dp;
    width: 440dp;
    height: 400dp;
    padding: 22dp;
}

#log-view {
    position: absolute;
    left: 22dp;
    top: 72dp;
    width: 396dp;
    height: 254dp;
    background: #fafbfc;
    border: 1dp #e6e8ec;
    border-radius: 9dp;
    overflow-y: auto;
    overflow-x: hidden;
}

#log-content {
    padding: 10dp 12dp;
    font-family: Consolas;
    font-size: 13dp;
    color: #374151;
    white-space: normal;
}

#log-content div {
    display: block;
    width: 368dp;
    margin-bottom: 3dp;
}

#log-dialog .dlg-buttons {
    position: absolute;
    right: 22dp;
    bottom: 18dp;
    height: 38dp;
}

/* mfa */
#mfa-dialog {
    left: 40dp;
    top: 130dp;
    width: 400dp;
    height: 250dp;
}

#mfa-note {
    position: absolute;
    left: 24dp;
    top: 84dp;
    width: 352dp;
    height: 34dp;
    font-size: 13dp;
    color: #b42318;
}

#mfa-code {
    position: absolute;
    left: 24dp;
    top: 124dp;
    box-sizing: border-box;
    width: 220dp;
    height: 44dp;
    padding: 0dp 12dp;
    font-family: Consolas;
    font-size: 20dp;
    text-align: center;
    color: #0f172a;
    background: #ffffff;
    border: 1dp #d8dce2;
    border-radius: 8dp;
}

#mfa-code:focus {
    border: 1dp #0b6b45;
}

#btn-mfa {
    position: absolute;
    left: 254dp;
    top: 124dp;
    width: 122dp;
    height: 44dp;
    line-height: 42dp;
    margin-left: 0dp;
    font-size: 15dp;
}

#mfa-hint {
    position: absolute;
    left: 24dp;
    top: 188dp;
    font-size: 12dp;
    color: #9aa1a9;
}
