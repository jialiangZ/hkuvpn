// Resource script for HKUVPN.exe (kept header-free so llvm-rc / windres
// both preprocess it without a Windows SDK on the include path).

// No application icon on purpose: the exe/window stays icon-less.

// Tray icons: multi-size ICOs whose colour encodes the connection state.
10 ICON "tray-gray.ico"    // disconnected
11 ICON "tray-green.ico"   // connected
12 ICON "tray-amber.ico"   // connecting
13 ICON "tray-red.ico"     // worker unresponsive

// Common-controls v6 + PerMonitorV2 DPI manifest. 24 = RT_MANIFEST.
1 24 "app.manifest"
