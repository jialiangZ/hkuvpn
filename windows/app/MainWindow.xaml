<Window x:Class="Hkuvpn.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HKU VPN"
        Width="680" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource BrushBg}"
        Icon="pack://application:,,,/app.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Ellipse x:Name="DotStatus" Width="18" Height="18" Margin="0,0,12,0"
                         Fill="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="LblStatus" Text="Disconnected"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushMuted}" />
                    <TextBlock x:Name="LblSub" Text="Tunnel is down"
                               FontSize="12" Margin="0,2,0,0"
                               Foreground="{StaticResource BrushMuted}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="HKU Portal VPN" FontSize="12"
                           Foreground="{StaticResource BrushAccent}" />
                <TextBlock Text="vpn2fa.hku.hk" FontSize="12" Margin="0,2,0,0"
                           Foreground="{StaticResource BrushMuted}" />
            </StackPanel>
        </Grid>

        <!-- Session card / MFA panel (same slot) -->
        <Grid Grid.Row="1">
            <Border x:Name="CardSession" Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="16,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Account"
                               Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ValAccount" Grid.Row="0" Grid.Column="1" Text="-"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="VPN address"
                               Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ValVpn" Grid.Row="1" Grid.Column="1" Text="-"
                               VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Duration"
                               Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ValDuration" Grid.Row="2" Grid.Column="1" Text="-"
                               VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Local proxy"
                               Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ValProxy" Grid.Row="3" Grid.Column="1"
                               Text="socks5://127.0.0.1:1080   http://127.0.0.1:1088"
                               VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Routes"
                               Foreground="{StaticResource BrushMuted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ValRoutes" Grid.Row="4" Grid.Column="1" Text="-"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border x:Name="MfaPanel" Background="{StaticResource BrushCard}"
                    BorderBrush="#5A4A1F" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Multi-factor authentication" FontSize="13"
                               Foreground="{StaticResource BrushOrange}" FontWeight="SemiBold" />
                    <TextBlock x:Name="LblMfaNote" Text="Enter the code showing NOW (previous was rejected)."
                               FontSize="12" Foreground="{StaticResource BrushRed}"
                               Margin="0,4,0,0" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox x:Name="TxtMfa" Width="190" Height="42" MaxLength="6"
                                 FontSize="24" FontFamily="Cascadia Mono, Consolas"
                                 Background="{StaticResource BrushLogBg}"
                                 Foreground="{StaticResource BrushText}"
                                 BorderBrush="#5A4A1F" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 VerticalAlignment="Center" />
                        <Button x:Name="BtnMfaSubmit" Content="Submit" Margin="12,0,0,0"
                                Style="{StaticResource BtnPrimary}" Height="42"
                                VerticalAlignment="Center" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnConnect" Content="Connect" Style="{StaticResource BtnPrimary}"
                    Width="150" Height="38" Click="BtnConnect_Click" />
            <Button x:Name="BtnDisconnect" Content="Disconnect" Style="{StaticResource BtnDanger}"
                    Width="150" Height="38" Margin="12,0,0,0" IsEnabled="False"
                    Click="BtnDisconnect_Click" />
        </StackPanel>

        <!-- Log -->
        <Border Grid.Row="3" Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True" Margin="0,0,0,12">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="14,8" Background="#222327">
                    <Grid>
                        <TextBlock Text="OpenConnect log  ·  live" FontSize="12"
                                   Foreground="{StaticResource BrushMuted}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="BtnClearLog" Content="Clear" Width="70" Height="24"
                                HorizontalAlignment="Right" FontSize="11" Padding="0"
                                Click="BtnClearLog_Click" />
                    </Grid>
                </Border>
                <TextBox x:Name="LogBox" Margin="10" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#C9D1D9"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                         TextChanged="LogBox_TextChanged" />
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <CheckBox x:Name="ChkTray" Content="Close button minimizes to tray"
                      IsChecked="True" Foreground="{StaticResource BrushMuted}" FontSize="12" />
            <TextBlock Text="hkuvpn desktop 1.0" HorizontalAlignment="Right"
                       Foreground="{StaticResource BrushMuted}" FontSize="12"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
