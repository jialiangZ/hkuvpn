# hkuvpn.ps1 configuration for hkuvpn - HKU campus VPN (native Windows port).
#
# Copy to %USERPROFILE%\.vpn\hku.env and edit. Simple KEY=VALUE lines only.

# Required: your HKU account, e.g. youruid@connect.hku.hk
HKU_USER=youruid@connect.hku.hk

# Local proxy ports (same defaults as the Docker edition).
HKU_SOCKS_PORT=1080
HKU_HTTP_PORT=1088

# 1 = let OpenConnect use DTLS/UDP for the tunnel data (lower latency on a
# clean path); unset/0 = force everything over the TCP channel. TCP is the
# default because cross-border links often throttle UDP into heavy loss,
# which stalls the session in confusing ways - while TCP only costs some
# latency. If your line has clean UDP (e.g. you are in Hong Kong), set 1.
# HKU_DTLS=1

# 0 = skip the DoH resolution of vpn2fa*.hku.hk (default is to resolve via
# 1.1.1.1/8.8.8.8 so fake-IP DNS from a rules client cannot poison the
# control connection).
HKU_AUTO_RESOLVE=1

# Extra subnets routed through the tunnel, comma-separated CIDR list, in
# ADDITION to the split routes the VPN server pushes. Use this for
# HKU-licensed resources that live on external networks, e.g.:
#   HKU_EXTRA_ROUTES=203.0.113.0/24,198.51.100.0/24
# Leave empty unless something you need is not reachable through the proxy.
HKU_EXTRA_ROUTES=

# Keepalive for idle sessions: seconds between tiny requests sent through
# the proxy while connected. HKU's gateway closes a session after 30
# minutes without data through the tunnel, even though OpenConnect keeps
# sending its own DPD/keepalive packets. Default 600 (10 minutes); keep it
# below the gateway's 1800-second limit, or set 0 to turn it off.
HKU_KEEPALIVE=600

# Automatic licensed-resource routing (default on). Every destination the
# local proxy connects to that is NOT covered by the campus split routes
# gets its prefix routed through the tunnel automatically (learned from the
# proxy's connection log), and the learning persists across sessions in
# %USERPROFILE%\.vpn\learned-routes.txt. A brand-new external resource
# works from the second request onward (refresh once); pre-seed known
# domains below to make even the first request work. Set 0 to disable.
HKU_AUTO_ROUTES=1

# Prefix length for auto-learned routes (24 routes a whole neighboring CDN
# block; 32 is strictest but needs re-learning when IPs rotate).
HKU_AUTO_ROUTES_PREFIX=24

# Cap and expiry for learned routes: at most 512 entries, unseen for 14
# days -> forgotten.
HKU_AUTO_ROUTES_MAX=512
HKU_AUTO_ROUTES_TTL=14

# Domains resolved and pre-routed at connect time, e.g. known library
# database hosts: "www.somedb.com,otherdb.example.org". Comma/space list.
HKU_PROXY_DOMAINS=

# 1 (default) = create an NRPT rule so *.hku.hk names resolve through the
# VPN's own DNS servers (campus-only names then work). 0 = rely on normal
# Windows DNS.
HKU_NRPT=1

# Suffixes covered by the NRPT rule (comma- or space-separated).
HKU_NRPT_DOMAINS=hku.hk
