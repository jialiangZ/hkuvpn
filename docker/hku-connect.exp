#!/usr/bin/expect -f

set timeout -1

foreach var {OC_USER OC_HOST OC_SERVERCERT} {
    if {![info exists env($var)]} {
        puts stderr "ERROR: environment variable $var is not set"
        exit 1
    }
}

# The PIN arrives through a read-only single-file mount (/run/hku-pass, backed
# by ~/.vpn/hku.pass), so it never appears in `docker run` arguments,
# `docker inspect`, or the host process list. HKU_PASSWORD remains supported
# as a legacy fallback. Re-read on every form
# round so a restarted auth form can be answered again.
proc load_pin {} {
    if {[file exists /run/hku-pass]} {
        set fh [open /run/hku-pass r]
        set pin [string trim [read $fh]]
        close $fh
        if {$pin ne ""} { return $pin }
        puts stderr "ERROR: /run/hku-pass is empty"
    } elseif {[info exists env(HKU_PASSWORD)]} {
        return $env(HKU_PASSWORD)
    } else {
        puts stderr "ERROR: no PIN available (expected the /run/hku-pass mount or HKU_PASSWORD)"
    }
    exit 1
}
set password [load_pin]

set user $env(OC_USER)
set host $env(OC_HOST)
set servercert $env(OC_SERVERCERT)
set response_file "/run/hkuvpn-response"
set mfa_mode "file"
if {[info exists env(OC_MFA_MODE)] && [string trim $env(OC_MFA_MODE)] ne ""} {
    set mfa_mode [string tolower [string trim $env(OC_MFA_MODE)]]
}
if {$mfa_mode ni {file terminal}} {
    puts stderr "ERROR: OC_MFA_MODE must be 'file' or 'terminal'"
    exit 1
}
set resolve_args {}
if {[info exists env(OC_RESOLVE)] && [string trim $env(OC_RESOLVE)] ne ""} {
    # HKU's public entry point redirects to one of several authentication
    # backends. Accept a comma-separated list so every control hostname can
    # be pinned to a real address when fake-IP DNS is enabled. A single value
    # remains backward compatible.
    foreach mapping [split $env(OC_RESOLVE) ","] {
        set mapping [string trim $mapping]
        if {$mapping ne ""} {
            lappend resolve_args "--resolve=$mapping"
        }
    }
}

proc append_session_marker {message} {
    global env
    if {![info exists env(OC_LOGFILE)] || [string trim $env(OC_LOGFILE)] eq ""} {
        return
    }

    if {[catch {
        set fh [open $env(OC_LOGFILE) a]
        puts $fh "[clock format [clock seconds] -format {%Y-%m-%dT%H:%M:%S%z}] $message"
        close $fh
    } err]} {
        puts stderr "Unable to append to OpenConnect session log: $err"
    }
}

proc enable_session_log {} {
    global env
    if {![info exists env(OC_LOGFILE)] || [string trim $env(OC_LOGFILE)] eq ""} {
        return
    }

    append_session_marker "post-MFA OpenConnect logging started"
    if {[catch {log_file -a $env(OC_LOGFILE)} err]} {
        puts stderr "Unable to enable OpenConnect session log: $err"
    } else {
        puts stderr "OpenConnect post-MFA log: $env(OC_LOGFILE)"
    }
}

proc finish_with_openconnect_status {context} {
    if {[catch {wait} wait_status]} {
        append_session_marker "openconnect wait failed after $context: $wait_status"
        puts stderr "openconnect wait failed after $context: $wait_status"
        exit 1
    }

    set exit_code 1
    if {[llength $wait_status] >= 4 && [lindex $wait_status 2] == 0} {
        set exit_code [lindex $wait_status 3]
    }

    append_session_marker "openconnect exited after $context; wait status: $wait_status"
    puts stderr "openconnect exited after $context; wait status: $wait_status"
    exit $exit_code
}

proc wait_for_mfa_response {path} {
    puts stderr "HKUVPN_MFA_RESPONSE_REQUIRED"
    puts stderr "Waiting for MFA response file: $path"

    while {1} {
        if {[file exists $path]} {
            set fh [open $path r]
            set response [string trim [read $fh]]
            close $fh
            file delete -force $path

            if {$response ne ""} {
                return $response
            }
        }
        after 500
    }
}

# gost in the background provides both listeners (SOCKS5 :1080 / HTTP :1088);
# the shell loop restarts it within a second if it ever exits unexpectedly.
exec /bin/sh -c {while :; do /usr/local/bin/gost -L socks5://:1080 -L http://:1088 >/dev/null 2>/dev/null; sleep 1; done} >/dev/null 2>/dev/null &

# Optional OC_NO_DTLS=1 (HKU_DTLS=0 in ~/.vpn/hku.env) forces all data over
# the CSTP/TCP channel: slower for bulk transfers, but immune to UDP-hostile
# paths (e.g. a rules client mishandling UDP) that leave DTLS dead and can
# wedge the session.
set dtls_args {}
if {[info exists env(OC_NO_DTLS)] && [string trim $env(OC_NO_DTLS)] eq "1"} {
    set dtls_args {--no-dtls}
}

# Foreground: spawn openconnect with credentials from env
spawn openconnect $host \
    {*}$resolve_args \
    {*}$dtls_args \
    --user=$user \
    --useragent=AnyConnect \
    --servercert $servercert \
    --verbose \
    --timestamp \
    --reconnect-timeout=1800 \
    --no-external-auth

if {$mfa_mode eq "terminal"} {
    expect {
        -nocase "Password:" {
            send "$password\r"
            unset password
        }
        eof {
            finish_with_openconnect_status "waiting for password prompt"
        }
    }
    expect {
        -nocase "Response:" {
            puts stderr "Enter the current MFA code at the Response prompt."
            interact
            finish_with_openconnect_status "interactive session"
        }
        eof {
            finish_with_openconnect_status "waiting for 2FA response prompt"
        }
    }
} else {
    # File mode: answer the auth form in a loop, so a rejected code (expired,
    # typo) or a restarted form is handled without restarting the container.
    expect {
        -nocase "Password:" {
            send "$password\r"
        }
        eof {
            finish_with_openconnect_status "waiting for password prompt"
        }
    }
    while {1} {
        expect {
            -nocase "Password:" {
                send "$password\r"
                exp_continue
            }
            -nocase "Response:" {
                set response [wait_for_mfa_response $response_file]
                send "$response\r"
                unset response
                exp_continue
            }
            -nocase "CSTP connected" {
                enable_session_log
                expect eof
                finish_with_openconnect_status "connected session"
            }
            eof {
                finish_with_openconnect_status "waiting for tunnel after 2FA"
            }
        }
    }
}
